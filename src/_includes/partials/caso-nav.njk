{#- Navegación de las páginas de caso (.reporte-page): índice pegajoso desde 1280px,
    botón e índice de pantalla chica, y botones de compartir. Antes cada caso llevaba su copia.
    Sale todo del front matter de la página:

      indice:
        nombre: "proyecto"            # "Índice del proyecto", "Navegación del proyecto"
        items:
          - { id: "sec-intro", corto: "El escenario", largo: "El escenario: 2032" }
        rail:                         # opcional: cifra bajo el índice (solo natalidad)
          valor: "−42,8&nbsp;%"
          etiqueta: "población de 4 años…"
      compartir:
        titulo: "…"                   # texto del tuit
        asunto: "… - BPP"             # asunto del mail
        cuerpo: "Te comparto…"        # el mail agrega ": " y la URL de la página

    `corto` va en el índice de escritorio; `largo` (si existe) en el de móvil.
    Las cifras del rail que cambian con el scroll están en main.js (railFigures). -#}
    <aside class="sticky-toc" id="stickyToc" aria-label="Índice del {{ indice.nombre }}">
      <p class="toc-label">Navegación</p>
      <ul>
{%- for item in indice.items %}
        <li><a href="#{{ item.id }}">{{ item.corto }}</a></li>
{%- endfor %}
      </ul>
{%- if indice.rail %}
      {#- Rail de cifras (scrollytelling): decorativo, duplica datos del contenido. #}
      <div class="toc-data-rail" id="dataRail" aria-hidden="true">
        <span class="data-rail-value">{{ indice.rail.valor | safe }}</span>
        <span class="data-rail-label">{{ indice.rail.etiqueta }}</span>
      </div>
{%- endif %}
    </aside>

    {#- Botón del índice (debajo de 1280px): dice "Índice" en lugar de repetir las tres rayas del
        menú. main.js lo esconde mientras se baja leyendo y lo vuelve a mostrar al subir. #}
    <button type="button" class="mobile-toc-btn" id="mobileTocBtn" aria-haspopup="dialog">Índice</button>

    <div class="mobile-toc-overlay" id="mobileTocOverlay" role="dialog" aria-modal="true" aria-label="Navegación del {{ indice.nombre }}">
      <button class="close-btn" id="closeMobileToc" aria-label="Cerrar índice">×</button>
      <div class="toc-content">
        <p class="toc-title">Navegación del {{ indice.nombre }}</p>
        <ul class="report-toc-list">
{%- for item in indice.items %}
          <li><a href="#{{ item.id }}">{{ item.largo or item.corto }}</a></li>
{%- endfor %}
        </ul>
      </div>
    </div>

    <div class="share-buttons" id="shareButtons">
      <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ site.url }}{{ page.url }}" target="_blank" rel="noopener noreferrer" aria-label="Compartir en LinkedIn">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <a href="https://twitter.com/intent/tweet?url={{ site.url }}{{ page.url }}&text={{ compartir.titulo | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Compartir en Twitter">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>
      <a href="mailto:?subject={{ compartir.asunto | urlencode }}&body={{ compartir.cuerpo | urlencode }}:%20{{ site.url }}{{ page.url }}" aria-label="Compartir por email">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
        </svg>
      </a>
    </div>
