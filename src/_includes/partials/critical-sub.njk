<style>
:root{--color-bg:#12151a;--color-text:#faf8f6;--color-text-light:rgba(250,248,246,0.87);--color-accent:#c16f52;--color-accent-hover:#c16f52;--border-radius:8px}*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth;scroll-padding-top:80px}body{font-family:'Plus Jakarta Sans',sans-serif;background-color:var(--color-bg);color:var(--color-text-light);line-height:1.7;overflow-x: clip}nav{position:fixed;top:0;left:0;right:0;z-index:1000;background:rgba(18, 21, 26,0.95);backdrop-filter:blur(10px);border-bottom:1px solid rgba(250,248,246,0.05);padding:2.5rem 0}.nav-container{width:100%;padding:0 6rem;display:flex;justify-content:space-between;align-items:center}.logo{display:flex;align-items:center;gap:1rem}.nav-wordmark{font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:1.1875rem;color:rgba(250,248,246,0.9);text-decoration:none}.nav-logo-icon{display:block;line-height:0}.nav-logo-icon img{height:52px;width:auto;display:block}.nav-links{display:flex;gap:2.5rem;list-style:none}.nav-links a{color:var(--color-text-light);text-decoration:none;font-size:1.1875rem;font-weight:400}.hero{min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:2rem}.hero-content{max-width:900px}.hero-logo{margin-bottom:3rem;height:160px;display:flex;align-items:center;justify-content:center}.hero-logo img{max-width:100%;max-height:160px;width:auto;height:auto;opacity:0.9;object-fit:contain}.tagline{font-size:clamp(2.5rem,7vw,5rem);font-weight:700;margin-bottom:1.5rem;color:var(--color-text)}.subtitle{font-size:clamp(1.25rem,2.5vw,1.5rem);margin-bottom:2rem;color:var(--color-text-light)}.locations{font-size:1.0625rem;color:var(--color-accent);margin-bottom:2.5rem}[data-animate]{opacity:1;transform:translateY(0)}[data-animate].animate-ready:not(.visible){opacity:1}@media (prefers-reduced-motion:reduce){svg *{animation:none!important}svg animate{display:none}}@media (prefers-reduced-motion:no-preference){bod